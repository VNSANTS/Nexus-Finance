# Copie este arquivo para .env.local e preencha com os valores reais do
# projeto (Supabase → Project Settings → API Keys). .env.local NÃO é
# versionado (ver .gitignore) — cada pessoa/ambiente tem o seu.
#
# A publishable key é segura de expor no frontend (é o que a RLS existe
# pra proteger). NUNCA coloque a secret key aqui nem em nenhum arquivo
# do frontend.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Opcional — só pra Tela de Notícias da Área do Investidor (Gestão
# Financeira). Sem essa chave, a tela mostra um aviso explicando como
# ativar em vez de quebrar. Cadastro grátis (sem cartão) em marketaux.com,
# plano gratuito = ~100 requisições/dia.
VITE_MARKETAUX_KEY=
